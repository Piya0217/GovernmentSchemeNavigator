# =============================================================================
# Government Scheme Navigator — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# ChromaDB
# ---------------------------------------------------------------------------
# Local persistence directory for the vector store
CHROMA_PERSIST_DIR=./data/chroma

# ---------------------------------------------------------------------------
# Embeddings
# ---------------------------------------------------------------------------
# HuggingFace model ID for multilingual sentence embeddings
# Recommended: intfloat/multilingual-e5-base or sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# ---------------------------------------------------------------------------
# LLM (future use)
# ---------------------------------------------------------------------------
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=

# ---------------------------------------------------------------------------
# API
# ---------------------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8000
# Browser origins that may call the API directly. Streamlit server-side requests
# do not require CORS. Keep this empty unless a browser client needs access.
CORS_ORIGINS=[]

# URL used by the citizen-facing Streamlit app to reach the FastAPI service.
# Streamlit and FastAPI are separate processes; change this for a deployed API.
API_BASE_URL=http://127.0.0.1:8000
